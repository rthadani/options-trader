{:tasks
 {repl
  {:doc "Start an interactive nREPL session"
   :override-builtin true
   :task (clojure "-M:dev -m nrepl.cmdline --interactive")}

  test
  {:doc "Run the full test suite via Kaocha"
   :task (clojure "-M:test")}

  lint
  {:doc "Lint source with clj-kondo (must be on PATH)"
   :task (shell "clj-kondo --lint src test")}

  format
  {:doc "Check formatting with cljfmt (must be on PATH)"
   :task (shell "cljfmt check src")}

  run-tui
  {:doc "Launch the TUI against the per-user config root (~/.config/options-trader, or $OPTIONS_TRADER_CONFIG_DIR)"
   :task (shell "bb" "tasks/run-tui.clj")}

  install
  {:doc "First-run install: prereq check, seed per-user config + screens + indicators + agents + skills, run DB migrations"
   :task (shell "bb" "tasks/install.clj")}

  refresh-data
  {:doc "Refresh market data for a universe — single JVM, single IB connection"
   :task (apply clojure (concat ["-M:cli" "refresh-all"] *command-line-args*))}

  generate-fixtures
  {:doc "Generate test fixtures (Phase 3 pending)"
   :task (println "generate-fixtures: phase 3 pending")}

  backup-db
  {:doc "Back up the DuckDB database to cache/backups/"
   :task (shell "bb tasks/backup-db.clj")}

  prune-db
  {:doc "Prune DuckDB backups older than 14 days"
   :task (shell "bb tasks/prune-db.clj")}}}
