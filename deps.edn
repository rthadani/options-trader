{:paths ["src" "resources"]

 :deps {org.clojure/clojure               {:mvn/version "1.12.0"}
        org.clojure/core.async            {:mvn/version "1.6.681"}
        ib-re-actor-976-plus/ib-re-actor-976-plus {:mvn/version "0.1.10.43.02"}
        twsapi/twsapi                     {:mvn/version "10.43.02"}
        org.ta4j/ta4j-core                {:mvn/version "0.16"}
        org.duckdb/duckdb_jdbc            {:mvn/version "1.1.3"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
        com.github.seancorfield/honeysql  {:mvn/version "2.6.1126"}
        com.github.clojure-finance/edgarjure {:mvn/version "0.1.9"}
        com.hypirion/clj-xchart           {:mvn/version "0.2.0"}
        cheshire/cheshire                 {:mvn/version "5.13.0"}
        http-kit/http-kit                 {:mvn/version "2.8.0"}
        org.babashka/http-client          {:mvn/version "0.4.22"}
        enlive/enlive                     {:mvn/version "1.1.6"}
        org.clojure/data.csv              {:mvn/version "1.0.1"}
        com.taoensso/timbre               {:mvn/version "6.5.0"}
        aero/aero                         {:mvn/version "1.1.6"}
        org.clojure/tools.cli             {:mvn/version "1.1.230"}
        io.github.TimoKramer/charm.clj   {:git/tag "v0.2.71" :git/sha "38e6823"}
        metosin/malli                     {:mvn/version "0.16.4"}
        hawk/hawk                         {:mvn/version "0.2.11"}
        nrepl/nrepl                       {:mvn/version "1.3.0"}
        lambdaisland/edn-lines            {:mvn/version "1.0.10"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps  {nrepl/nrepl {:mvn/version "1.3.0"}}}

  :test
  {:extra-paths ["test" "test/resources"]
   :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :run
  {:main-opts ["-m" "options-trader.core"]}

  :uberjar
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.3"}}
   :ns-default build}

  :mcp-server
  {:main-opts ["-m" "options-trader.mcp.server"]}

  :cli
  {:main-opts ["-m" "options-trader.cli"]}}}
