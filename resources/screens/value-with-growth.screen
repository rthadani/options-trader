---
name: Value with Growth
description: Cheap on FCF yield + low leverage + growing revenue and earnings — classic GARP screen
universe: latest_indicators
tags: [value, growth, fundamentals, fcf, garp]
---
SELECT symbol FROM latest_indicators
WHERE pe_ratio < 22
  AND fcf_yield > 0.04
  AND debt_to_equity < 1.0
  AND revenue_growth_yoy > 0.05
  AND eps_growth_yoy > 0.10
  AND gross_margin > 0.30
ORDER BY fcf_yield DESC LIMIT 25
